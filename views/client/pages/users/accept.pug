extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
    .container.my-3

        include ../../partials/list-btn-users.pug

        .row
            .col-12
                +box-head("Lời mời kết bạn")

        .row
            each user in users
                .col-6
                    .box-user.add
                        .inner-avatar
                            img(
                                src=user.avatar ? user.avatar : "/images/avatar.png"
                                alt=user.fullName
                            )

                        .inner-info
                            .inner-name #{user.fullName}

                            .inner-buttons
                                button(
                                    class="btn btn-sm btn-primary me-1"
                                    btn-accept-friend=user.id
                                ) Chấp nhận

                                button(
                                    class="btn btn-sm btn-secondary me-1"
                                    btn-refuse-friend=user.id
                                ) Xóa

                                button(
                                    class="btn btn-sm btn-secondary me-1"
                                    btn-deleted-friend
                                    disabled
                                ) Đã xoá
                                button(
                                    class="btn btn-sm btn-primary me-1"
                                    btn-accepted-friend
                                    disabled
                                ) Đã chấp nhận

block script
    script(src="/js/users.js")