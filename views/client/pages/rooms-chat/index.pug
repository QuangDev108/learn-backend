extends ../../layouts/default.pug

include ../../mixins/box-head.pug

block main
    .container.my-3

        .row
            .col-12
                +box-head("Danh sách phòng")

        .row.mb-3
            .col-12
                a(
                    href="/rooms-chat/create"
                    class="btn btn-sm btn-success m-1"
                ) Tạo phòng chat

        .row
            each room in listRoomChat
                .col-6
                    .box-room
                        .inner-avatar
                            img(
                                src="https://robohash.org/hicveldicta.png"
                                alt=room.title
                            )

                        .inner-info
                            .inner-name=room.title
                            .inner-buttons
                                a(
                                    href=`/chat/${room._id}`
                                    class="btn btn-sm btn-primary m-1"
                                ) Nhắn tin